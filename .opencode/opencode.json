{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "talosctl *read*kubeconfig*": "deny",
      "talosctl *read*cert*": "deny",
      "talosctl *read*key*": "deny",
      "talosctl *read*secret*": "deny",
      "talosctl *read*talosconfig*": "deny",
      "talosctl *read*/var/lib/*": "deny",
      "kubectl cp*": "deny",
      "kubectl exec*-- env*": "deny",
      "kubectl exec*-- printenv*": "deny",
      "kubectl exec*-- export*": "deny",
      "kubectl exec*-- cat*": "deny",
      "kubectl exec*-- sh*": "deny",
      "kubectl exec*-- bash*": "deny",
      "kubectl exec*-- python*": "deny",
      "helm get values*": "deny",
      "helm get manifest*": "deny",
      "*get secret *-o yaml*": "deny",
      "*get secrets *-o yaml*": "deny",
      "*get secret *-o jsonpath*": "deny",
      "*get secrets *-o jsonpath*": "deny",
      "*get secret *-o go-template*": "deny",
      "*get secrets *-o go-template*": "deny",
      "akeyless get-secret-value*": "deny"
    }
  },
  "mcp": {
    "litellm-homelab": {
      "type": "remote",
      "url": "https://litellm.t0m.co/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:LITELLM_API_KEY}",
        "x-mcp-servers": "context7_mcp,searxng_mcp,github_mcp,deepwiki_mcp,talos_mcp,konflate_mcp,victoria_logs_mcp,sidero_mcp"
      }
    },
    "memini": {
      "type": "remote",
      "url": "https://memini.t0m.co/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:MEMINI_API_KEY}",
        "X-Memini-Namespace": "tscibilia/home-ops"
      }
    }
  },
  "plugins": [
    {
      "package": "@eleboucher/opencode-memini-v2",
      "options": {
        "namespace": "tscibilia/home-ops",
        "base_url": "https://memini.t0m.co/",
        "recall_budget_ms": 8000
      }
    }
  ]
}
