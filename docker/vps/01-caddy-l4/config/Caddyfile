{
	email {$CADDY_ACME_EMAIL}
	http_port 8080
	https_port 8443

	layer4 {
		:443 {
			matching_timeout 15s
			@local tls sni {$VPS_LOCAL_HOSTS}
			route @local {
				proxy {
					proxy_protocol v2
					upstream 127.0.0.1:8443
				}
			}
			@tls tls
			route @tls {
				proxy {
					proxy_protocol v2
					upstream towonel-hub:4443
				}
			}
		}
	}

	# Only TCP is published to this container, so HTTP/3 is unreachable.
	# Left on, Caddy still advertises Alt-Svc h3 and browsers cache it for
	# 30 days, then blackhole every request onto UDP that never arrives.
	servers :8443 {
		listener_wrappers {
			proxy_protocol {
				timeout 2s
				allow 127.0.0.1/32
			}
			tls
		}
		protocols h1 h2
	}

	servers :4443 {
		protocols h1 h2
	}

	log default {
		output stdout
		format json
	}
}

{$TOWONEL_HUB_HOSTNAME} {
	log
	reverse_proxy towonel-hub:8443
}

# UniFi controller UI. Sibling container on the edge network, not a
# remote upstream. It presents a self-signed cert, so TLS verification is
# disabled for this upstream only.
#
# Served on the default port like every other vhost, so it goes through
# the layer4 :443 SNI path. The controller's own super_identity.hostname
# is "unf.t0m.co" with no port; publishing it on :4443 gave the browser an
# origin the controller did not recognise as itself, and it discarded the
# session it had just issued.
#
# UniFi rejects a request whose Origin does not match its Host with an
# empty 403. Since v2.11.0 Caddy silently overwrites Host with the upstream
# address when the upstream is https:// -- which it must be here, because
# the controller serves a self-signed cert. UniFi then compared the
# browser's Origin against "unifi-network-application:8443" and refused
# every login. Restoring the client's Host is the fix; do NOT "solve" this
# by stripping Origin, which only hides the mismatch.
#
# Served on both ports deliberately. :443 is the browser URL and goes
# through the layer4 SNI path; :4443 is bound directly and is the one the
# UniFi iOS app needs -- it treats 443 as a UniFi OS console and probes
# /proxy/network/*, which a standalone Network Application does not serve.
# `header_up Host` keeps Origin matching on whichever port is used, so
# neither address needs special handling.
{$UNIFI_HOSTNAME}, {$UNIFI_HOSTNAME}:4443 {
	log

	reverse_proxy https://unifi-network-application:8443 {
		header_up Host {http.request.hostport}
		transport http {
			tls_insecure_skip_verify
		}
	}
}
