{
	email {$CADDY_ACME_EMAIL}
	http_port 8080
	https_port 8443

	layer4 {
		:443 {
			matching_timeout 15s
			@local tls sni {$VPS_LOCAL_HOSTS}
			route @local {
				proxy {
					proxy_protocol v2
					upstream 127.0.0.1:8443
				}
			}
			@tls tls
			route @tls {
				proxy {
					proxy_protocol v2
					upstream towonel-hub:4443
				}
			}
		}
	}

	# Only TCP is published to this container, so HTTP/3 is unreachable.
	# Left on, Caddy still advertises Alt-Svc h3 and browsers cache it for
	# 30 days, then blackhole every request onto UDP that never arrives.
	servers :8443 {
		listener_wrappers {
			proxy_protocol {
				timeout 2s
				allow 127.0.0.1/32
			}
			tls
		}
		protocols h1 h2
	}

	log default {
		output stdout
		format json
	}
}

{$TOWONEL_HUB_HOSTNAME} {
	log
	reverse_proxy towonel-hub:8443
}

# UniFi controller UI. Sibling container on the edge network, not a
# remote upstream. It presents a self-signed cert, so TLS verification is
# disabled for this upstream only.
#
# Served on the default port like every other vhost, so it goes through
# the layer4 :443 SNI path. The controller's own super_identity.hostname
# is "unf.t0m.co" with no port; publishing it on :4443 gave the browser an
# origin the controller did not recognise as itself, and it discarded the
# session it had just issued.
#
# UniFi validates Origin against the request Host itself, and does it
# correctly: a matching Origin is accepted, a foreign one gets an empty
# 403. Do not reintroduce an Origin allowlist or a `header_up -Origin`
# strip here -- the earlier "403 on any Origin" reading came from probing
# with a Host that did not match the Origin being sent.
{$UNIFI_HOSTNAME} {
	log

	reverse_proxy https://unifi-network-application:8443 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}
