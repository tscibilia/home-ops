{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/*.env": "deny",
      "**/.env.*": "deny",
      "**/*.env.*": "deny",
      "**/.envrc": "deny",
      "**/.env.example": "allow",
      "**/*.env.example": "allow",
      "**/.env.sample": "allow",
      "**/*.env.sample": "allow",
      "**/.env.template": "allow",
      "**/*.env.template": "allow",
      "**/.env.dist": "allow",
      "**/*.env.dist": "allow",
      "**/*.sqlite": "deny",
      "**/*.db": "deny",
      "**/.kube/config": "deny",
      "**/talosconfig": "deny",
      "**/*.key": "deny",
      "**/*.pem": "deny"
    },
    "edit": {
      "*": "allow",
      "**/.env": "deny",
      "**/*.env": "deny",
      "**/.env.*": "deny",
      "**/*.env.*": "deny",
      "**/.envrc": "deny",
      "**/.env.example": "allow",
      "**/*.env.example": "allow",
      "**/.env.sample": "allow",
      "**/*.env.sample": "allow",
      "**/.env.template": "allow",
      "**/*.env.template": "allow",
      "**/.env.dist": "allow",
      "**/*.env.dist": "allow",
      "**/*.sqlite": "deny",
      "**/*.db": "deny"
    },
    "bash": {
      "*": "allow",
      "pg_dump*": "deny",
      "pg_restore*": "deny",
      "sops -d*": "deny",
      "sops exec-env*": "deny",
      "printenv*": "deny",
      "ps eww*": "deny",
      "cat *.sqlite*": "deny",
      "env": "deny",
      "helm get values*": "deny",
      "helm get manifest*": "deny",
      "kubectl cp*": "deny",
      "kubectl exec*-- env*": "deny",
      "kubectl exec*-- printenv*": "deny",
      "kubectl exec*-- export*": "deny",
      "kubectl exec*-- cat*": "deny",
      "kubectl exec*-- sh*": "deny",
      "kubectl exec*-- bash*": "deny",
      "kubectl exec*-- python*": "deny",
      "sqlite3*.dump*": "deny",
      "sqlite3*select *": "deny",
      "psql*select *": "deny",
      "*get secret *-o yaml*": "deny",
      "*get secrets *-o yaml*": "deny",
      "*get secret *-o jsonpath*": "deny",
      "*get secrets *-o jsonpath*": "deny",
      "*get secret *-o go-template*": "deny",
      "*get secrets *-o go-template*": "deny",
      "*get secret *-o json*": "deny",
      "*get secrets *-o json*": "deny",
      "akeyless get-secret-value*": "deny",
      "aws secretsmanager get-secret-value*": "deny",
      "gcloud secrets versions access*": "deny",
      "vault kv get*": "deny",
      "doppler secrets download*": "deny",
      "op item get*--reveal*": "deny"
    }
  },
  "provider": {
    "opencode": {
      "options": {
        "apiKey": "{env:OPENCODE_API_KEY}"
      }
    }
  },
  "mcp": {
    "litellm-homelab": {
      "type": "remote",
      "url": "http://litellm.ai.svc.cluster.local:4000/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:LITELLM_API_KEY}",
        "x-mcp-servers": "context7_mcp,searxng_mcp,github_mcp,deepwiki_mcp"
      }
    }
  }
}
