{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "**/.env", "effect": "deny" },
    { "action": "read", "resource": "**/*.env", "effect": "deny" },
    { "action": "read", "resource": "**/*.sqlite", "effect": "deny" },
    { "action": "read", "resource": "**/*.db", "effect": "deny" },
    { "action": "read", "resource": "**/kubeconfig", "effect": "deny" },
    { "action": "read", "resource": "**/talosconfig", "effect": "deny" },
    { "action": "read", "resource": "**/*.key", "effect": "deny" },
    { "action": "read", "resource": "**/*.pem", "effect": "deny" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "**/.env", "effect": "deny" },
    { "action": "edit", "resource": "**/*.env", "effect": "deny" },
    { "action": "edit", "resource": "**/*.sqlite", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "sqlite3*", "effect": "deny" },
    { "action": "shell", "resource": "* sqlite3*", "effect": "deny" },
    { "action": "shell", "resource": "pg_dump*", "effect": "deny" },
    { "action": "shell", "resource": "pg_restore*", "effect": "deny" },
    { "action": "shell", "resource": "sops -d*", "effect": "deny" },
    { "action": "shell", "resource": "sops exec-env*", "effect": "deny" },
    { "action": "shell", "resource": "printenv*", "effect": "deny" },
    { "action": "shell", "resource": "ps eww*", "effect": "deny" },
    { "action": "shell", "resource": "cat *.env*", "effect": "deny" },
    { "action": "shell", "resource": "cat *.sqlite*", "effect": "deny" },
    { "action": "shell", "resource": "env", "effect": "deny" },
    { "action": "shell", "resource": "psql*", "effect": "ask" },
    { "action": "shell", "resource": "aws secretsmanager get-secret-value*", "effect": "ask" },
    { "action": "shell", "resource": "gcloud secrets versions access*", "effect": "ask" },
    { "action": "shell", "resource": "vault kv get*", "effect": "ask" },
    { "action": "shell", "resource": "doppler secrets download*", "effect": "ask" },
    { "action": "shell", "resource": "op item get*", "effect": "ask" }
  ],
  "provider": {
    "litellm": {
      "name": "LiteLLM",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://litellm.ai.svc.cluster.local:4000/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "qwen-local": {
          "name": "Local/Qwen3.8-27B",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": { "context": 180224, "output": 32768 }
        },
        "qwen-local-fast": {
          "name": "Local/Qwen3.8-27B (fast)",
          "attachment": true,
          "reasoning": false,
          "tool_call": true,
          "temperature": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": { "context": 180224, "output": 32768 }
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "attachment": false,
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "limit": { "context": 1000000, "output": 384000 }
        },
        "deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": { "context": 1000000, "output": 384000 }
        }
      }
    }
  },
  "mcp": {
    "litellm-homelab": {
      "type": "remote",
      "url": "http://litellm.ai.svc.cluster.local:4000/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:LITELLM_API_KEY}",
        "x-mcp-servers": "talos_mcp,konflate_mcp,victoria_logs_mcp,sidero_mcp"
      }
    }
  }
}
