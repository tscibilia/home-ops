{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/*.env": "deny",
      "**/*.sqlite": "deny",
      "**/*.db": "deny",
      "**/kubeconfig": "deny",
      "**/talosconfig": "deny",
      "**/*.key": "deny",
      "**/*.pem": "deny"
    },
    "edit": {
      "*": "allow",
      "**/.env": "deny",
      "**/*.env": "deny",
      "**/*.sqlite": "deny"
    },
    "bash": {
      "*": "allow",
      "sqlite3*": "deny",
      "* sqlite3*": "deny",
      "pg_dump*": "deny",
      "pg_restore*": "deny",
      "sops -d*": "deny",
      "sops exec-env*": "deny",
      "printenv*": "deny",
      "ps eww*": "deny",
      "cat *.env*": "deny",
      "cat *.sqlite*": "deny",
      "env": "deny",
      "psql*": "ask",
      "aws secretsmanager get-secret-value*": "ask",
      "gcloud secrets versions access*": "ask",
      "vault kv get*": "ask",
      "doppler secrets download*": "ask",
      "op item get*": "ask"
    }
  },
  "provider": {
    "litellm": {
      "name": "LiteLLM",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://litellm.ai.svc.cluster.local:4000/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "qwen-local": {
          "name": "Local/Qwen3.8-27B",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": { "context": 180224, "output": 32768 }
        },
        "qwen-local-fast": {
          "name": "Local/Qwen3.8-27B (fast)",
          "attachment": true,
          "reasoning": false,
          "tool_call": true,
          "temperature": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": { "context": 180224, "output": 32768 }
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "attachment": false,
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "limit": { "context": 1000000, "output": 384000 }
        },
        "deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": { "context": 1000000, "output": 384000 }
        }
      }
    }
  },
  "mcp": {
    "litellm-homelab": {
      "type": "remote",
      "url": "http://litellm.ai.svc.cluster.local:4000/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:LITELLM_API_KEY}",
        "x-mcp-servers": "talos_mcp,konflate_mcp,victoria_logs_mcp,sidero_mcp"
      }
    }
  }
}
