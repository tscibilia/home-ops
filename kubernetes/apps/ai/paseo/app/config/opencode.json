{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/*.env": "deny",
      "**/*.sqlite": "deny",
      "**/*.db": "deny",
      "**/.kube/config": "deny",
      "**/talosconfig": "deny",
      "**/*.key": "deny",
      "**/*.pem": "deny"
    },
    "edit": {
      "*": "allow",
      "**/.env": "deny",
      "**/*.env": "deny",
      "**/*.sqlite": "deny",
      "**/*.db": "deny"
    },
    "bash": {
      "*": "allow",
      "pg_dump*": "deny",
      "pg_restore*": "deny",
      "sops -d*": "deny",
      "sops exec-env*": "deny",
      "printenv*": "deny",
      "ps eww*": "deny",
      "cat *.sqlite*": "deny",
      "env": "deny",
      "helm get values*": "deny",
      "helm get manifest*": "deny",
      "kubectl exec*": "deny",
      "kubectl cp*": "deny",
      "*get secret *-o yaml*": "deny",
      "*get secrets *-o yaml*": "deny",
      "*get secret *-o jsonpath*": "deny",
      "*get secrets *-o jsonpath*": "deny",
      "*get secret *-o go-template*": "deny",
      "*get secrets *-o go-template*": "deny",
      "akeyless get-secret-value*": "deny",
      "aws secretsmanager get-secret-value*": "deny",
      "gcloud secrets versions access*": "deny",
      "vault kv get*": "deny",
      "doppler secrets download*": "deny",
      "op item get*--reveal*": "deny"
    }
  },
  "provider": {
    "litellm": {
      "name": "LiteLLM",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://litellm.ai.svc.cluster.local:4000/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "qwen-local": {
          "name": "Local/Qwen3.8-27B",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": { "context": 180224, "output": 32768 }
        },
        "qwen-local-fast": {
          "name": "Local/Qwen3.8-27B (fast)",
          "attachment": true,
          "reasoning": false,
          "tool_call": true,
          "temperature": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": { "context": 180224, "output": 32768 }
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "attachment": false,
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "limit": { "context": 1000000, "output": 384000 }
        },
        "deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": { "context": 1000000, "output": 384000 }
        }
      }
    }
  },
  "mcp": {
    "litellm-homelab": {
      "type": "remote",
      "url": "http://litellm.ai.svc.cluster.local:4000/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:LITELLM_API_KEY}",
        "x-mcp-servers": "talos_mcp,konflate_mcp,victoria_logs_mcp,sidero_mcp"
      }
    }
  }
}
