{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  dependencyDashboardAutoclose: false,
  dependencyDashboardFooter: "This dashboard is automatically maintained by Renovate.",
  vulnerabilityAlerts: false,
  customManagers: [
    {
      // inbox-zero publishes its Helm chart only inside the app repo (no OCI
      // artifact, no index.yaml, no chart version bumps), so the chart is
      // resolved from a GitRepository pinned to a commit. Renovate's flux
      // manager only understands ref.tag/semver, so track main's HEAD digest
      // with the git-refs datasource instead. The image tag in the same app
      // moves separately as a docker digest of `latest`, which upstream builds
      // from that same main HEAD.
      customType: "regex",
      description: "Track upstream inbox-zero main HEAD as the chart GitRepository commit",
      managerFilePatterns: ["/^kubernetes\\/apps\\/ai\\/inbox-zero\\/app\\/gitrepository\\.yaml$/"],
      matchStrings: ["commit:\\s*(?<currentDigest>[0-9a-f]{40})"],
      currentValueTemplate: "main",
      depNameTemplate: "elie222/inbox-zero",
      packageNameTemplate: "https://github.com/elie222/inbox-zero",
      datasourceTemplate: "git-refs",
    },
  ],
  packageRules: [
    {
      // The flux manager also extracts this GitRepository, but without a
      // ref.tag it has no ref name to resolve a digest from, so it can only
      // report an unupdatable dep. The git-refs custom manager above is the
      // working path; suppress the duplicate.
      description: "inbox-zero: suppress the flux manager's unupdatable GitRepository commit dep",
      matchManagers: ["flux"],
      matchDatasources: ["git-refs"],
      matchPackageNames: ["https://github.com/elie222/inbox-zero.git"],
      enabled: false,
    },
    {
      description: "Loose versioning for RustFS, stable tags only (excludes -glibc and -preview variants)",
      matchDatasources: ["docker"],
      matchPackageNames: ["rustfs/rustfs"],
      versioning: "loose",
      allowedVersions: "/^\\d+\\.\\d+\\.\\d+$/",
    },
    {
      description: "Cal-commit versioning for SearXNG (weekly updates) shaped semver/calver + '-<commit-sha>'",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/searxng/searxng"],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-[a-f0-9]+$",
      schedule: ["before 3am on Monday"],
    },
    {
      description: "Track FileBrowser Quantum 2.x.x-beta only (v2 config layout is still moving; a silent jump to stable risks a config migration, and stable/latest still resolve to the v1 line)",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/gtsteffaniak/filebrowser"],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-beta$",
      allowedVersions: "/^2\\./",
    },
    {
      // mise maps the aqua: backend to github-tags, so Renovate fires on a pushed tag
      // hours before the upstream release workflow publishes the binaries
      description: "Wait for aqua tags to settle before alerting",
      matchDatasources: ["github-tags"],
      matchManagers: ["mise"],
      matchDepNames: ["/^aqua:/"],
      minimumReleaseAge: "3 days",
    },
    {
      // resolve from releases so a version with no published binaries is never offered;
      // kustomize is excluded — it tags releases "kustomize/vX.Y.Z", which extractVersion won't strip
      description: "Resolve aqua tools from GitHub releases, not tags (cilium-cli v0.20.0 was tagged with no release)",
      matchDatasources: ["github-tags"],
      matchManagers: ["mise"],
      matchDepNames: [
        "aqua:cilium/cilium-cli",
        "aqua:cli/cli",
        "aqua:fluxcd/flux2",
        "aqua:helmfile/helmfile",
        "aqua:mitsuhiko/minijinja",
      ],
      overrideDatasource: "github-releases",
    },
    {
      description: "Constrain ofelia to 0.x (v3.0.8 is a stale erroneous tag from 2023)",
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/mcuadros/ofelia"],
      allowedVersions: "/^0\\./",
    },
    {
      description: "Constrain prompp to 0.x (3.8.x is the same manifest digest as 0.8.x)",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/deckhouse/prompp"],
      allowedVersions: "/^0\\./",
    },
    {
      description: "Resolve Immich from GitHub releases (paging 40k+ GHCR tags intermittently 429s, failing the lookup)",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "ghcr.io/immich-app/immich-server",
        "ghcr.io/immich-app/immich-machine-learning",
      ],
      overrideDatasource: "github-releases",
      overridePackageName: "immich-app/immich",
    },
    {
      // Tags are "pg<pgMajor>.<pgMinor>-ts<semver>". Default docker versioning cannot parse
      description: "TimescaleDB HA uses 'pg<major>.<minor>-ts<semver>' tags",
      matchDatasources: ["docker"],
      matchPackageNames: ["timescale/timescaledb-ha"],
      versioning: "regex:^pg(?<compatibility>\\d+)\\.(?<major>\\d+)-ts(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)$",
    },
    {
      description: "No digest-only PRs for TimescaleDB HA",
      matchDatasources: ["docker"],
      matchPackageNames: ["timescale/timescaledb-ha"],
      matchUpdateTypes: ["digest"],
      enabled: false,
    },
    {
      description: "No digest-only PRs for CNPG postgresql",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/cloudnative-pg/postgresql"],
      matchUpdateTypes: ["digest"],
      enabled: false,
    },
    {
      // mise pulls prebuilt CPython from python-build-standalone, which lags the
      // python/cpython tag Renovate bumps to. Wait for pbs to ship the prebuild;
      // local `compile = true` covers any remaining gap.
      description: "Wait 28 days for python-build-standalone to ship the prebuilt CPython before bumping mise python",
      matchManagers: ["mise"],
      matchDepNames: ["python"],
      minimumReleaseAge: "28 days",
    },
  ],
}
